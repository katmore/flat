#!/bin/sh
# Runs flat's PHPUnit suite natively, on a machine with PHP 7.3 and PHPUnit
# installed (e.g. after `composer install`). docker/bin/test runs this same
# script inside the repository's PHP container and starts any services it needs.
set -eu
# The script lives in bin/; work from the repository root.
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
# Explicit inputs: the PHP binary, PHPUnit, and an optional bootstrap overriding
# phpunit.xml.dist (the Docker image sets the last two for its own install).
php_bin="${FLAT_TEST_PHP:-php}"
phpunit="${FLAT_TEST_PHPUNIT:-vendor/bin/phpunit}"
usage() {
    echo 'Usage: bin/test [all|unit|services|mongo|rabbitmq|anet|sandbox] [--coverage] [PHPUnit arguments]'
    echo '       bin/test inventory [KNOWN-DEFECTS.md] > TEST-INVENTORY.md'
    echo '       bin/test services-needed [mode] [PHPUnit arguments]'
    echo '  all (default): every test; MongoDB/RabbitMQ tests need those services reachable'
    echo '  unit:          tests that need no external services'
    echo '  services:      MongoDB-, RabbitMQ- and Authorize.Net-mock-dependent tests'
    echo '  mongo:         MongoDB-dependent tests'
    echo '  rabbitmq:      RabbitMQ-dependent tests'
    echo '  anet:          the Authorize.Net tests, against a WireMock stand-in (FLAT_TEST_ANET_URL,'
    echo '                 login, key and run id are set by docker/bin/test)'
    echo '  sandbox:       the same tests against the real Authorize.Net sandbox (Internet and'
    echo '                 credentials needed; not part of all). Set FLAT_TEST_ANET_LOGIN_ID and'
    echo '                 FLAT_TEST_ANET_TRANSACTION_KEY to a sandbox account (and leave'
    echo '                 FLAT_TEST_ANET_URL unset). They fail, not skip, without them.'
    echo '  services-needed: print the test services (mongo rabbitmq anet-mock) the tests this run selects'
    echo '                 need, nothing if none; docker/bin/test starts only those'
    echo '  inventory:     print a Markdown inventory of every test to stdout, from'
    echo "                 PHPUnit's test list; KD IDs are added from a given defects file"
    echo '  --coverage:    write reports under build/tests/<mode>/ (needs Xdebug)'
    echo '  -h, --help:    show this usage'
    echo 'Environment: FLAT_TEST_PHP (default php), FLAT_TEST_PHPUNIT (default'
    echo '  vendor/bin/phpunit), FLAT_TEST_BOOTSTRAP (optional PHPUnit bootstrap),'
    echo '  FLAT_TEST_MONGODB_URI and FLAT_TEST_RABBITMQ_HOST for service tests.'
    echo '  FLAT_TEST_CA_BUNDLE (optional CA file PHP trusts for the sandbox tests).'
    echo 'To run everything in Docker instead, use docker/bin/test with the same arguments.'
}
test_mode=all
coverage=false
action=run
defects_file=
while [ "$#" -gt 0 ]; do
    case "$1" in
        all|unit|services|mongo|rabbitmq|anet|sandbox) test_mode=$1 ;;
        services-needed) action=services-needed ;;
        inventory)
            action=inventory
            if [ "$#" -gt 1 ] && [ "${2#-}" = "$2" ]; then defects_file=$2; shift; fi ;;
        --coverage) coverage=true ;;
        -h|--help) usage; exit ;;
        --) shift; break ;;
        -*) break ;;
        *) printf 'Unknown test type: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done
if [ ! -f "$phpunit" ]; then
    printf 'PHPUnit not found at %s. Run composer install, set FLAT_TEST_PHPUNIT,\nor use docker/bin/test.\n' "$phpunit" >&2
    exit 2
fi
suite=unit
# An optional CA bundle for TLS (for example behind a proxy that re-signs traffic); PHP settings only.
ca_flags=
[ -n "${FLAT_TEST_CA_BUNDLE:-}" ] && ca_flags="-d curl.cainfo=$FLAT_TEST_CA_BUNDLE -d openssl.cafile=$FLAT_TEST_CA_BUNDLE"
phpunit_cmd() {
    if [ -n "${FLAT_TEST_BOOTSTRAP:-}" ]; then
        "$php_bin" $ca_flags "$phpunit" --bootstrap "$FLAT_TEST_BOOTSTRAP" --testsuite "$suite" "$@"
    else
        "$php_bin" $ca_flags "$phpunit" --testsuite "$suite" "$@"
    fi
}
if [ "$action" = inventory ]; then
    if [ -n "$defects_file" ] && [ ! -f "$defects_file" ]; then
        printf 'Defects file not found: %s\n' "$defects_file" >&2; exit 2
    fi
    # Only the Markdown goes to stdout.
    list_dir=build/tests/inventory
    mkdir -p "$list_dir"
    phpunit_cmd --list-tests-xml "$list_dir/tests.xml" >/dev/null
    if [ -n "$defects_file" ]; then
        exec "$php_bin" tests/tools/inventory.php "$list_dir/tests.xml" "$defects_file"
    fi
    exec "$php_bin" tests/tools/inventory.php "$list_dir/tests.xml"
fi
case "$test_mode" in
    unit) set -- --exclude-group services "$@" ;;
    services) set -- --group services "$@" ;;
    mongo) set -- --group mongo "$@" ;;
    rabbitmq) set -- --group rabbitmq "$@" ;;
    anet) set -- --group anet "$@" ;;
    sandbox)
        # Only this mode talks to the real sandbox: the tests refuse to otherwise.
        unset FLAT_TEST_ANET_URL
        export FLAT_TEST_ANET_SANDBOX=1
        set -- --group sandbox "$@" ;;
esac
if [ "$action" = services-needed ]; then
    # Which services do the tests this run selects need? Only the list is made; no test runs.
    list_dir=build/tests/services-needed
    mkdir -p "$list_dir"
    phpunit_cmd --list-tests-xml "$list_dir/tests.xml" >/dev/null
    exec "$php_bin" tests/tools/services.php "$list_dir/tests.xml" "$@"
fi
if "$coverage"; then
    report_dir="build/tests/$test_mode"
    mkdir -p "$report_dir"
    set -- --coverage-text="$report_dir/coverage.txt" \
        --coverage-clover="$report_dir/coverage.xml" \
        --coverage-php="$report_dir/coverage.php" \
        --log-junit="$report_dir/junit.xml" "$@"
fi
# PHPUnit's result cache (see phpunit.xml.dist) lives under build/tests/, which is ignored by Git
# and writable for the container user (docker/bin/test); the folder must exist.
mkdir -p build/tests
phpunit_cmd "$@"
