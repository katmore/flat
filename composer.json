{
   "name": "katmore/flat",
   "description" : "experimental framework for php",
   "homepage":"https://github.com/katmore/flat",
    "autoload": {
        "psr-4": {
            "flat\\":        "src/flat"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "flat\\test\\": "tests/"
        }
    },
    "license": [
       "MIT",
       "GPL-3.0-or-later"
    ],
    "require": {
        "php" : ">=7.2.1",
        "mongodb/mongodb": "^1.0.0",
        "alcaeus/mongo-php-adapter": "^1.0",
        "authorizenet/authorizenet": "^1.9",
        "aws/aws-sdk-php": "^3.23"
     },
    "require-dev": {
        "phpunit/phpunit": "^8.5"
    },
    "scripts": {
        "test": "phpunit --testsuite unit"
    }
}
