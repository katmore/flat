# Port 2222: authenticates like port 22 but refuses every shell, exec and subsystem channel (MaxSessions 0), so the tests can see an
# exec request fail on a connected client.
Port 2222
HostKey /etc/ssh/ssh_host_ed25519_key
PasswordAuthentication yes
PubkeyAuthentication no
KbdInteractiveAuthentication no
StrictModes no
AllowUsers flat
PermitRootLogin no
MaxSessions 0
LogLevel INFO
