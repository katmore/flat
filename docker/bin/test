#!/bin/sh
# Runs bin/test inside the repository's PHP 7.3 container. This script only
# handles Docker: it builds or checks the image, starts the MongoDB/RabbitMQ
# containers a test mode needs, runs bin/test with the same arguments, and
# removes the containers afterwards. All test logic lives in bin/test.
set -eu
# The script lives in docker/bin/; work from the repository root.
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_dir"
export FLAT_TEST_UID="$(id -u)" FLAT_TEST_GID="$(id -g)"
# Root ignores file permissions, so tests of unreadable/unwritable paths cannot
# fail as root (common in CI). Run PHP unprivileged; reports stay writable below.
if [ "$FLAT_TEST_UID" = 0 ]; then export FLAT_TEST_UID=1000 FLAT_TEST_GID=1000; fi
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-flat-tests}"
compose() {
    files="-f docker/docker-compose.yml"
    # The sandbox mode needs the Internet and no services (see docker/docker-compose.sandbox.yml).
    if [ "${test_mode:-all}" = sandbox ]; then
        files="$files -f docker/docker-compose.sandbox.yml"
        if [ -n "${FLAT_TEST_CA_FILE:-}" ]; then files="$files -f tests/docker/compose.sandbox.ca.yaml"; fi
    fi
    case "${test_mode:-all}" in all|services|anet) files="$files -f docker/docker-compose.anet-mock.yml" ;; esac
    if [ "${offline:-false}" != true ] && [ -n "${FLAT_TEST_CA_FILE:-}" ]; then
        # Newer Compose builds through Bake, which refuses a secret read from a
        # path outside the build context unless file-read entitlements are relaxed.
        BUILDX_BAKE_ENTITLEMENTS_FS="${BUILDX_BAKE_ENTITLEMENTS_FS:-0}" \
            docker compose $files -f tests/docker/compose.ca.yaml "$@"
    else
        docker compose $files "$@"
    fi
}
usage() {
    echo 'Usage: docker/bin/test [bin/test arguments] [--offline]'
    echo '       docker/bin/test --build | --down'
    echo 'Runs bin/test in the PHP 7.3 container and starts the services its test mode'
    echo 'needs. Docker-only options:'
    echo '  --offline:     use existing images only; never build or pull'
    echo '  --build:       build the test image only'
    echo '  --down:        remove this test stack (after an interrupted run)'
    echo 'Examples: docker/bin/test unit --filter SshTest; docker/bin/test all --offline --coverage'
    echo 'Optional: docker/bin/test sandbox runs the tests against the real Authorize.Net sandbox (needs'
    echo 'FLAT_TEST_ANET_LOGIN_ID and FLAT_TEST_ANET_TRANSACTION_KEY in your shell; never part of all).'
    echo 'docker/bin/test anet runs only the Authorize.Net tests, against the WireMock stand-in that all and'
    echo 'services also use (answers follow the documentation; fake credentials, no Internet needed).'
    echo
    echo 'bin/test arguments:'
    bin/test --help | sed -n '1,/^  -h/p'
}
offline=false
action=run
test_mode=all
inventory=false
passthrough=true
# Remove the Docker-only options; forward every other argument to bin/test.
for arg do
    shift
    if "$passthrough"; then
        case "$arg" in
            --offline) offline=true; continue ;;
            --build) action=build; continue ;;
            --down) action=down; continue ;;
            -h|--help) usage; exit ;;
            --) passthrough=false ;;
            all|unit|services|mongo|rabbitmq|anet|sandbox) test_mode=$arg ;;
            inventory) inventory=true ;;
        esac
    fi
    set -- "$@" "$arg"
done
if [ "$action" = down ]; then compose down --volumes --remove-orphans; exit; fi
if [ "$action" = build ] && "$offline"; then
    echo '--build and --offline cannot be combined' >&2; exit 2
fi
# The services a test mode could need. Which of them the selected tests do need is worked out further down.
candidates=
if ! "$inventory"; then
    case "$test_mode" in
        all|services) candidates='mongo rabbitmq anet-mock' ;;
        mongo) candidates=mongo ;;
        rabbitmq) candidates=rabbitmq ;;
        anet) candidates=anet-mock ;;
    esac
fi
# Offline: every image must already exist. Names come only from the fixed values above and below; no host parser
# or private cache is required, and Compose supplies the exact pinned image refs.
check_images() {
    image_refs=$(compose config --images $*)
    for image_ref in $image_refs; do
        if ! docker image inspect "$image_ref" >/dev/null 2>&1; then
            printf 'Offline image missing: %s\nRun docker/bin/test all online once to prepare the images.\n' "$image_ref" >&2
            exit 1
        fi
    done
}
if "$offline"; then
    check_images php
else
    # Build progress goes to stderr: the inventory action prints only its Markdown to stdout.
    compose build php >&2
fi
if [ "$action" = build ]; then exit; fi
# bin/test writes reports and test lists under build/tests/. The container user
# may differ from the host user (see the root case above).
mkdir -p build/tests
[ "$(id -u)" = "$FLAT_TEST_UID" ] || chmod -R a+rwX build/tests
cleanup() {
    test_status=$?
    trap - EXIT INT TERM
    compose down --volumes --remove-orphans || test_status=1
    exit "$test_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# Starting the services can fail now and then (RabbitMQ has been seen to exit at startup; the cause was never
# captured, because the container is removed with its log). So a failed start is retried, never silently: each
# failure prints the services' state and their own logs first, and the third failure stops the run.
start_services() {
    attempt=1
    while :; do
        if "$offline"; then
            if compose up -d --wait --pull never $service_names; then return 0; else status=$?; fi
        else
            if compose up -d --wait $service_names; then return 0; else status=$?; fi
        fi
        printf 'Starting the test services failed (attempt %s of 3, status %s). State and logs follow.\n' "$attempt" "$status" >&2
        compose ps -a >&2 || true
        compose logs --no-color --tail=80 $service_names >&2 || true
        compose down --volumes --remove-orphans >&2 || true
        if [ "$attempt" -ge 3 ]; then return "$status"; fi
        attempt=$((attempt + 1))
        printf 'Trying again (attempt %s of 3).\n' "$attempt" >&2
    done
}
# Start only the services the selected tests need: a run that selects no MongoDB, RabbitMQ or Authorize.Net mock
# test starts none of them. bin/test lists the tests the arguments select; nothing runs and no service is needed.
service_names=
if [ -n "$candidates" ]; then
    if listing=$(compose run --rm -T --no-deps --pull never --entrypoint sh php bin/test services-needed "$@"); then
        needed=$(printf '%s\n' "$listing" | tail -n 1)
    else
        printf 'Could not work out which services the tests need; starting all that this mode can use.\n' >&2
        needed=$candidates
    fi
    for name in $candidates; do
        case " $needed " in *" $name "*) service_names="$service_names $name" ;; esac
    done
    service_names=${service_names# }
    printf 'Test services needed: %s\n' "${service_names:-none}" >&2
    if "$offline" && [ -n "$service_names" ]; then check_images php $service_names; fi
fi
if [ -n "$service_names" ]; then
    start_services
fi
if "$inventory"; then
    # No TTY, so only bin/test's Markdown reaches stdout.
    compose run --rm -T --no-deps --pull never --entrypoint sh php bin/test "$@"
else
    compose run --rm --no-deps --pull never --entrypoint sh php bin/test "$@"
fi
